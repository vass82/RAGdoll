APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# LLM provider: "openai" (cloud, requires OPENAI_API_KEY) or "ollama" (local)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Local Sentence Transformers model; downloaded from Hugging Face on first use
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
